{
  "$schema": "../scene.schema.json",
  "configuration": {
    "theme": {
      "id": "clear"
    },
    "widgets": [
      {
        "id": "apple",
        "type": "appleMenu",
        "position": "left"
      },
      {
        "id": "app-menu",
        "type": "appMenu",
        "position": "left",
        "expandOnHover": true
      },
      {
        "id": "battery",
        "type": "battery",
        "position": "right",
        "details": true
      },
      {
        "id": "clock",
        "type": "clock",
        "position": "right",
        "format": "EEE d  HH:mm",
        "details": true,
        "layout": {
          "type": "row",
          "children": [
            {
              "type": "field",
              "field": "date",
              "role": "secondary"
            },
            {
              "type": "field",
              "field": "time",
              "role": "time"
            }
          ]
        }
      },
      {
        "id": "menu-bar-items",
        "type": "menuBarItems",
        "position": "right"
      },
      {
        "id": "quick-toggles",
        "type": "quickToggles",
        "position": "right"
      }
    ]
  },
  "outputs": {
    "battery": {
      "text": "82%",
      "icon": "battery.75percent",
      "values": {
        "percent": 0.82
      },
      "fields": {
        "percent": "82",
        "state": "battery",
        "present": "true",
        "health": "normal",
        "timeRemaining": "285"
      }
    }
  },
  "activeApp": "com.apple.Notes",
  "appearances": ["dark"],
  "draw": "bar"
}
