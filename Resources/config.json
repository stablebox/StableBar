{
  "$schema": "https://raw.githubusercontent.com/Seb-GRAF/StableBar/main/stablebar.schema.json",
  "theme": {
    "id": "clear"
  },
  "bar": {
    "offset": 0
  },
  "widgets": [
    {
      "id": "apple",
      "type": "appleMenu",
      "position": "left"
    },
    {
      "id": "app-menu",
      "type": "appMenu",
      "position": "left"
    },
    {
      "id": "sound",
      "type": "audio",
      "position": "right",
      "details": true
    },
    {
      "id": "clock",
      "type": "clock",
      "position": "right",
      "format": "EEE d MMM  HH:mm",
      "details": true
    },
    {
      "id": "menu-bar-items",
      "type": "menuBarItems",
      "position": "right"
    },
    {
      "id": "quick-toggles",
      "type": "quickToggles",
      "position": "right"
    }
  ]
}
